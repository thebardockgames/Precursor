<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog background in Precursor's style: the launcher's panel colour with the brass edge of
     the in-game menu (GameMenuView). The inset keeps the dialog off the screen edges. (AI-assisted) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp"
    android:insetTop="24dp"
    android:insetRight="20dp"
    android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="#1B2833" />
        <corners android:radius="22dp" />
        <stroke android:width="1dp" android:color="#59E2B25A" />
    </shape>
</inset>
