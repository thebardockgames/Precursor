;; Visit every main Jak 1 continue point and stay 45 s in each. (AI-assisted)
;; A crash or hang in a level shows up in the devloop report with the last [script-print].
;; Run: scripts/android-port/devloop.sh -S scripts/android-port/devloop-scripts/jak1-tour.gc -t 1500 -H 60
(format #t "[script-print] going to training-start~%")
(start 'play (get-continue-by-name *game-info* "training-start"))
(script-wait 45)
(format #t "[script-print] training-start: level0=~A level1=~A~%" (-> *level* level0 name) (-> *level* level1 name))
(format #t "[script-print] going to village1-hut~%")
(start 'play (get-continue-by-name *game-info* "village1-hut"))
(script-wait 45)
(format #t "[script-print] village1-hut: level0=~A level1=~A~%" (-> *level* level0 name) (-> *level* level1 name))
